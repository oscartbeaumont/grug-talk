{
  "manifest_version": 3,
  "name": "Grug X",
  "version": "1.0.0",
  "description": "Make X speak like Grug, powered by Chrome's on-device AI when available.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "Grug X", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
